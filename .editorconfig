root = true

[*]
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.md]
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.feature]
indent_style = unset
indent_size = unset

[package-lock.json]
indent_style = unset
indent_size = unset
